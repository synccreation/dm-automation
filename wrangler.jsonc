{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dm-automation",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "PUBLIC_URL": "https://dm-automation.synccreation.workers.dev",
    // Shown on the privacy / data-deletion pages Meta requires.
    "CONTACT_EMAIL": "synccreation@artlayers.info"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dm-automation",
      "database_id": "186cd30d-2d3a-4425-a246-db55a4c835c1",
      "migrations_dir": "migrations"
    }
  ]
}
